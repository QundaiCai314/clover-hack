{
  "name": "clover-hackathon",
  "version": "0.1.1",
  "description": "Clover（三叶草）— 专为黑客松比赛设计的命令行 AI Agent",
  "keywords": [
    "hackathon",
    "agent",
    "cli",
    "ai",
    "clover"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "clover": "dist/index.js"
  },
  "files": [
    "dist",
    "src/templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "node --test",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "author": "QundaiCai314",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QundaiCai314/clover-hack.git"
  },
  "homepage": "https://github.com/QundaiCai314/clover-hack",
  "bugs": {
    "url": "https://github.com/QundaiCai314/clover-hack/issues"
  }
}
